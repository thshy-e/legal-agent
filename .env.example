# Alibaba Cloud DashScope API key
# Console: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key
# Use the OpenAI-compatible URL matching the key's region/workspace.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional; derived from the compatible URL by default. Workspace keys require
# the corresponding workspace host for BOTH chat and embeddings.
# DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# CASE_MODEL_ENABLED=0 runs the deterministic workflow without model roles.
# Judge/Doc use qwen-plus. Review is independently configurable.
CASE_MODEL_ENABLED=1
# Optional mixed profile; qwen-plus remains the default for compatibility.
# CASE_REVIEW_MODEL=qwen3.8-max
# Changing model profiles invalidates prior case confirmations.
# Enable only after building the version-matched vectors with --embeddings.
LEGAL_VECTOR_SEARCH=0
